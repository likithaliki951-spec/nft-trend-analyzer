# ==============================================================================
# Streamlit Secrets Configuration Template
# For local use: Copy this file to .streamlit/secrets.toml
# For Streamlit Community Cloud: Paste into Settings -> Secrets in your app dashboard
# ==============================================================================

# 1. Cryptographic Cookie & Session Token Secret
# (Generate a random 32-character string using: python -c "import secrets; print(secrets.token_hex(32))")
[auth]
cookie_secret = "replace-with-a-secure-random-32-byte-hex-string"

# 2. Configured User Accounts (Salted PBKDF2 Password Hashes)
# Passwords are NEVER stored in plaintext.
# To generate a hash for your custom password, run in your terminal:
# python -c "import auth; print(auth.hash_password('YOUR_CUSTOM_PASSWORD'))"
[credentials.users."admin@yourfirm.com"]
name = "System Administrator"
role = "admin"
password_hash = "pbkdf2_sha256$600000$481ccc06f1dfa1f8af2a555f2192e44f$3e3d3bb4a6652dcbabba3935fc652bdca2d016c0c8a95e13dd93f732e98fe50d"

# [credentials.users."analyst@yourfirm.com"]
# name = "Lead Analyst"
# role = "analyst"
# password_hash = "pbkdf2_sha256$600000$..."

# 3. Optional External Marketplace & Valuation APIs
# OpenSea API v2 Key (Get from developer.opensea.io)
OPENSEA_API_KEY = "your-opensea-api-key"

# CoinGecko Demo API Key (Optional for higher rate limits from coingecko.com)
COINGECKO_API_KEY = "your-coingecko-demo-key"

# 4. Optional Streamlit Native OpenID Connect (OIDC) SSO
# (If using Google, Auth0, or Microsoft Entra ID)
# [auth.google]
# client_id = "your-google-client-id.apps.googleusercontent.com"
# client_secret = "your-google-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# redirect_uri = "https://your-app-name.streamlit.app/oauth2callback"
